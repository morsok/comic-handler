FROM node:22

WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies
RUN npm install

# Install Angular CLI globally
RUN npm install -g @angular/cli

# Expose port for Angular development server
EXPOSE 4200

# Start Angular development server with hot-reloading
# The --host 0.0.0.0 makes the server accessible from outside the container
# --disable-host-check allows requests from the host system
# --poll=2000 enables polling for changes (useful in some Docker environments)
CMD ["ng", "serve", "--host", "0.0.0.0"]
